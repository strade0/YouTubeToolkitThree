{
  "manifest_version": 3,
  "name": "YouTube Toolkit",
  "version": "1.0.8",
  "description": "Volume drag, layout trimmer, auto Jump Ahead, and 2x speed lock — essential YouTube tools, each with its own toggle.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Toolkit",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["features/volume/main_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/volume/styles.css"],
      "js": [
        "features/volume/visualizer.js",
        "features/volume/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/trimmer/content.css"],
      "js": ["features/trimmer/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["features/skipit/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/speed/styles.css"],
      "js": ["features/speed/content.js"],
      "run_at": "document_start"
    }
  ]
}
