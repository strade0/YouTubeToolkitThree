{
  "manifest_version": 3,
  "name": "YouTube Toolkit",
  "short_name": "YT Toolkit",
  "version": "1.2.0",
  "description": "Volume, layout, Jump Ahead, headphone pause/play, and speed tools for YouTube and YouTube Music.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Toolkit",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": [
        "features/volume/main_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/volume/styles.css"],
      "js": [
        "features/volume/visualizer.js",
        "features/volume/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/trimmer/content.css"],
      "js": ["features/trimmer/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["features/skipit/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/speed/styles.css"],
      "js": ["features/speed/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["onboarding/overlay-host.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "onboarding/onboarding.html",
        "onboarding/onboarding.css",
        "onboarding/onboarding.js",
        "onboarding/translations.js",
        "prototypes/assets/headphones-colored.webp",
        "prototypes/assets/side-tap-hand.webp"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
